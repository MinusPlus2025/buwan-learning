# 本地服务端口
PORT=4173

# 前端 WorkBuddy Cloud SDK 直接连接云模型，无需服务端模型密钥
# 服务端不实现通用 model BFF

# 可选：配置后启用 Brave 官方 Web Search（需要有效的付费授权）
# 仅服务端读取；留空时使用无需密钥的 Wikipedia，非全网或课程搜索
# Brave 请求失败时降级 Wikipedia，并在结果中标明实际来源
BRAVE_SEARCH_API_KEY=

# 历史占位配置，当前实现不读取
ANYSEARCH_API_KEY=

# 星云数字人官方 SDK 会话代理，仅服务端读取；两项均配置才可连接
# 上游会话地址固定，前端仅接收 appId 和短期连接凭证
XINGYUN_APP_ID=
XINGYUN_APP_SECRET=

# 可选：已知公网域名（逗号分隔），用于部署网关改写 Host 且不回传转发头时
# 判定同源 POST 请求；留空时默认 buwan-learning.app.workbuddy.host
PUBLIC_ORIGINS=
